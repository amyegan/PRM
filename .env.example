# Copy to .env.local for local development. On Vercel, set these in Project Settings →
# Environment Variables (or with `vercel env add`). Only DATABASE_URL, APP_PASSWORD, and
# OWNER_EMAIL are required; every integration below is optional and switches off when unset.

# --- Basics -------------------------------------------------------------------

# Postgres. Add Neon from the Vercel Marketplace (sets DATABASE_URL), or use any Postgres.
# POSTGRES_URL is accepted as a fallback name.
DATABASE_URL=

# Password for the web app. Required in production.
APP_PASSWORD=

# Your email: the only sender the agent accepts, and where the weekly and daily emails go.
OWNER_EMAIL=you@example.com

# Optional: the name shown in the web app, as the email sender, and as the chat bot's name.
# NEXT_PUBLIC_APP_NAME=PRM

# --- Model --------------------------------------------------------------------

# AI Gateway. Not needed on Vercel (OIDC is automatic). Locally, `vercel env pull` provides
# VERCEL_OIDC_TOKEN; elsewhere, create a key at https://vercel.com/d?to=/[team]/~/ai/api-keys
AI_GATEWAY_API_KEY=
# Optional: AI Gateway model ID for the agent and the share page's card reader. Must accept images.
# AGENT_MODEL=anthropic/claude-sonnet-5.5

# --- Email (Resend) -----------------------------------------------------------

# The Resend integration on Vercel sets RESEND_API_KEY and RESEND_EMAIL_DOMAIN.
# The agent sends from prm@$RESEND_EMAIL_DOMAIN; that domain must also receive email in Resend.
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
# Signing secret of the email.received webhook you create in Resend.
RESEND_WEBHOOK_SECRET=
# Optional: override the full from address.
# RESEND_FROM_ADDRESS=

# Optional: when the scheduled emails go out (5-field cron, evaluated in UTC on Vercel).
# WEEKLY_DIGEST_CRON=0 15 * * 1
# DAILY_DIGEST_CRON=0 23 * * *

# --- Public share page --------------------------------------------------------

# Secret for https://<your-app>/share?key=<SHARE_KEY>. Leave empty to turn the page off.
# Generate one with: openssl rand -hex 24
SHARE_KEY=
# Optional: send visitors with a missing or wrong key here (e.g. your website) instead of a 404.
REDIRECT_URL=

# --- Facebook Messenger (optional) --------------------------------------------

# Without these three, /eve/v1/messenger answers 503.
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=
# Your page-scoped Messenger ID: message the Page once, then copy it from the
# "[messenger] Ignoring message from sender …" log line.
OWNER_MESSENGER_ID=

# --- GitHub error reports (optional) ------------------------------------------

# Vercel Connect connector created with `vercel connect create github --name <name>`.
# GITHUB_CONNECTOR=github/prm
# Repo for error reports, as owner/name. Defaults to the repo the Vercel deployment was built from.
# GITHUB_ISSUES_REPO=
