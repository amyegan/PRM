# Postgres. Add Neon from the Vercel Marketplace, then `vercel env pull .env.local`.
DATABASE_URL=

# AI Gateway. Not needed on Vercel (OIDC is automatic). Locally, `vercel env pull` provides
# VERCEL_OIDC_TOKEN, or create a key at https://vercel.com/d?to=/[team]/~/ai/api-keys
AI_GATEWAY_API_KEY=

# Password for the web app. Required in production.
APP_PASSWORD=

# Resend. The Resend integration on Vercel sets RESEND_API_KEY and RESEND_EMAIL_DOMAIN.
# The agent sends from prm@$RESEND_EMAIL_DOMAIN; that domain must also receive email in Resend.
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
# Signing secret of the email.received webhook you create in Resend.
RESEND_WEBHOOK_SECRET=
# Optional: override the full from address.
# RESEND_FROM_ADDRESS=

# Secret for the public share page: https://<your-app>/share?key=<SHARE_KEY>
# Leave empty to turn the page off. Generate one with: openssl rand -hex 24
SHARE_KEY=
# Optional: send visitors with a missing or wrong key here (e.g. your website) instead of a 404.
REDIRECT_URL=

# The only address allowed to email the agent, and where the weekly digest goes.
OWNER_EMAIL=you@example.com
